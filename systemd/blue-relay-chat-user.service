[Unit]
Description=Blue Relay Chat RPi 4 Client (User Service)
Documentation=https://github.com/blue-relay-chat/blue-relay-chat-rpi4
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
User=%i
Group=%i
WorkingDirectory=%h/.local/share/blue-relay-chat
ExecStart=%h/.local/share/blue-relay-chat/venv/bin/python -m bitchat.main
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=blue-relay-chat

# Environment variables
Environment=PYTHONPATH=%h/.local/share/blue-relay-chat
Environment=BRC_CONFIG_DIR=%h/.config/blue-relay-chat
Environment=BRC_DATA_DIR=%h/.local/share/blue-relay-chat
Environment=DISPLAY=:0

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=%h/.local/share/blue-relay-chat %h/.config/blue-relay-chat %h/.local/share/blue-relay-chat/logs

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=default.target